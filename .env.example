# AlsaniaMCP environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# Server
PORT=8050

# MCP Registry
MCP_REGISTRY_URL=
MCP_REGISTRY_PORT=
REGISTRY_DIR=
REGISTRY_JSON=
REGISTRY_YAML=
REGISTRY_BASE=

# A2A communication
A2A_DISABLED=false
A2A_CONFIG_PATH=
AGENT_COMMS_ENABLED=true
AGENT_COMMS_BIN=

# Slack (secrets — set via environment, never hardcode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_MCP_XOXB_TOKEN=
SLACK_MCP_XOXP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_RELAY_ENABLED=
SLACK_MCP_ADD_MESSAGE_TOOL=
