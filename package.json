{
  "name": "@alsania-io/mcp",
  "version": "1.0.4",
  "description": "AlsaniaMCP - Universal MCP proxy server with dynamic tool aggregator, AI communication, and voice activation",
  "keywords": [
    "alsaniamcp",
    "mcp",
    "model-context-protocol",
    "ai",
    "proxy",
    "stdio",
    "sse",
    "http",
    "websocket",
    "stream",
    "bridge",
    "gateway",
    "voice",
    "universal"
  ],
  "homepage": "https://github.com/alsania-dev/alsaniamcp#readme",
  "bugs": {
    "url": "https://github.com/alsania-dev/alsaniamcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alsania-dev/alsaniamcp.git"
  },
  "license": "MIT",
  "author": "Alsania",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "alsaniamcp": "dist/cli.js",
    "amcp": "dist/cli.js"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "lint": "eslint src/**/*.ts tests/**/*.ts --ext .ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "type-check": "tsc --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "build:mcpb": "node scripts/build-mcpb.cjs",
    "security:audit": "npm audit --audit-level=moderate",
    "security:scan": "npm run security:audit && echo '=== TruffleHog Secret Scan ===' && trufflehog3 filesystem . --no-fail --json | head -20",
    "performance:test": "artillery run tests/performance/load-test.yml",
    "performance:report": "artillery report tests/performance/reports/*.json",
    "accessibility:test": "echo 'Accessibility testing not fully configured yet'",
    "clean": "rm -rf dist coverage .nyc_output tests/reports",
    "prepare-env": "node -e \"if (!require('fs').existsSync('.env')) { console.log('Create .env file manually'); } else { console.log('Environment file exists'); }\"",
    "ci": "npm run clean && npm run prepare-env && npm run lint && npm run type-check && npm run build && npm run test:coverage && npm run security:scan",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@alsania-io/acl": "file:../../packages/acl",
    "@alsania-io/gateway": "^1.0.6",
    "@alsania-io/scribe": "file:../../packages/scribe",
    "@alsania-io/utils": "file:../../packages/utils",
    "@genkit-ai/mcp": "^1.16.1",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@noble/hashes": "^2.0.1",
    "@slack/bolt": "^4.7.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "ora": "^9.0.0",
    "tsx": "^4.20.6",
    "ws": "^8.18.3",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/ora": "^3.2.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "artillery": "^2.0.26",
    "axios": "^1.13.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "lighthouse": "^13.0.1",
    "nodemon": "^3.1.10",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "prev-modelcontextprotocol-sdk": "npm:@modelcontextprotocol/sdk@^1.20.2",
    "supertest": "^7.1.4",
    "trufflehog": "^0.0.5",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
